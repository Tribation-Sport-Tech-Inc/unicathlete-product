      "endIndex": 407,
      "namedStyleType": "HEADING_1",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Product overview ",
      "protectedControls": []
    },
    {
      "paragraphId": "P00004",
      "path": "tabs.t.0.body.content[4]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 407,
      "endIndex": 408,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "",
      "protectedControls": []
    },
    {
      "paragraphId": "P00005",
      "path": "tabs.t.0.body.content[5]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 408,
      "endIndex": 716,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "UnicAthlete is a sports recruiting platform where athletes create sports portfolios and Scouts search for and review athletes. The platform may include athletes as young as 8 years old. Because adult Scouts may access information about minor athletes, minor safety and privacy are core product requirements.",
      "protectedControls": []
    },
    {
