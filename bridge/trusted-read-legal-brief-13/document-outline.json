      "text": "Users and roles",
      "protectedControls": []
    },
    {
      "paragraphId": "P00016",
      "path": "tabs.t.0.body.content[16]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 898,
      "endIndex": 920,
      "namedStyleType": "HEADING_2",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Athlete Profile users",
      "protectedControls": []
    },
    {
      "paragraphId": "P00017",
      "path": "tabs.t.0.body.content[17]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 920,
      "endIndex": 976,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.uk9izeo2kidy",
      "nestingLevel": null,
      "table": null,
      "text": "Athlete: the person represented by the Athlete Profile.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00018",
      "path": "tabs.t.0.body.content[18]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 976,
      "endIndex": 1068,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.uk9izeo2kidy",
      "nestingLevel": null,
      "table": null,
      "text": "Guardian: the adult user who manages or supervises a minor athlete’s profile when required.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00019",
      "path": "tabs.t.0.body.content[19]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1068,
      "endIndex": 1098,
      "namedStyleType": "HEADING_2",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Scout and administrator users",
      "protectedControls": []
    },
    {
      "paragraphId": "P00020",
      "path": "tabs.t.0.body.content[20]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1098,
      "endIndex": 1174,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.cs7w1mjv6ohd",
      "nestingLevel": null,
      "table": null,
      "text": "Scout: must be 18 or older and is the only user managing the Scout profile.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00021",
      "path": "tabs.t.0.body.content[21]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1174,
      "endIndex": 1335,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.cs7w1mjv6ohd",
      "nestingLevel": null,
      "table": null,
      "text": "Administrator: a named, MFA-protected internal account with restricted permission to review Scout affiliations. Shared administrator credentials are prohibited.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00022",
      "path": "tabs.t.0.body.content[22]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1335,
      "endIndex": 1336,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "",
      "protectedControls": []
    },
    {
      "paragraphId": "P00023",
      "path": "tabs.t.0.body.content[23]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1336,
      "endIndex": 1366,
      "namedStyleType": "HEADING_1",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Athlete visibility and access",
      "protectedControls": []
    },
    {
      "paragraphId": "P00024",
      "path": "tabs.t.0.body.content[24]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1366,
      "endIndex": 1367,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "",
      "protectedControls": []
    },
    {
      "paragraphId": "P00025",
      "path": "tabs.t.0.body.content[25]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1367,
      "endIndex": 1421,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Profiles are not intended for search-engine indexing.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00026",
      "path": "tabs.t.0.body.content[26]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1421,
      "endIndex": 1513,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Each Athlete Sport Profile has a visibility setting: Private or Visible to eligible Scouts.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00027",
      "path": "tabs.t.0.body.content[27]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1513,
      "endIndex": 1640,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Visibility is never enabled automatically. All eligibility gates must pass and the authorized user must explicitly turn it on.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00028",
      "path": "tabs.t.0.body.content[28]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1640,
      "endIndex": 1672,
      "namedStyleType": "HEADING_1",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Age-based athlete account model",
      "protectedControls": []
    },
    {
      "paragraphId": "P00029",
      "path": "tabs.t.0.body.content[29]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1672,
      "endIndex": 1848,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Age bands are calculated from the athlete’s date of birth. After account creation, the date of birth is locked and may be corrected only through an authorized support process.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00030",
      "path": "tabs.t.0.body.content[30]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1848,
      "endIndex": 1949,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.2nvn7x2ggzc3",
      "nestingLevel": null,
      "table": null,
      "text": "Under 14 — Guardian-managed: the Guardian creates and manages the profile; the athlete has no login.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00031",
      "path": "tabs.t.0.body.content[31]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1949,
      "endIndex": 2434,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.2nvn7x2ggzc3",
      "nestingLevel": null,
      "table": null,
      "text": "Ages 14–15 — Supervised: a Guardian is required. The athlete or Guardian may start the account. Before the athlete joins, the Guardian manages the private profile. After the athlete joins, the athlete edits ordinary profile content while the Guardian retains view access and controls visibility. A Guardian must approve each new Scout conversation and each request to share private information or documents. The Guardian can view the communication and withdraw permission at any time.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00032",
      "path": "tabs.t.0.body.content[32]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 2434,
      "endIndex": 2881,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.2nvn7x2ggzc3",
      "nestingLevel": null,
      "table": null,
      "text": "Ages 16–17 — Supervised by default: the same supervised rules apply unless independent communication is jointly accepted by the athlete and Guardian after the athlete activates their login. In independent mode, routine Guardian approval of communication with Scout is not required. The athlete may enable visibility once all gates pass; either the athlete or Guardian may make the profile private. The Guardian remains connected with view access.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00033",
      "path": "tabs.t.0.body.content[33]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 2881,
      "endIndex": 2991,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.2nvn7x2ggzc3",
      "nestingLevel": null,
      "table": null,
      "text": "Age 18+ — Athlete-managed: minor-based Guardian access ends and the athlete becomes the sole profile manager.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00034",
      "path": "tabs.t.0.body.content[34]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 2991,
      "endIndex": 2992,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "",
      "protectedControls": []
    },
    {
      "paragraphId": "P00035",
      "path": "tabs.t.0.body.content[35]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 2992,
      "endIndex": 3177,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Age transitions never automatically grant access, independence or visibility. If newly applicable requirements are incomplete, the affected feature moves to the safer restricted state.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00036",
      "path": "tabs.t.0.body.content[36]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3177,
      "endIndex": 3197,
      "namedStyleType": "HEADING_1",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Guardian safeguards",
      "protectedControls": []
    },
    {
      "paragraphId": "P00037",
      "path": "tabs.t.0.body.content[37]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3197,
      "endIndex": 3307,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Before a minor athlete’s Sport Profile can be made visible to eligible Scouts, the responsible Guardian must:",
      "protectedControls": []
    },
    {
      "paragraphId": "P00038",
      "path": "tabs.t.0.body.content[38]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3307,
      "endIndex": 3335,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.8vdujc3prvqi",
      "nestingLevel": null,
      "table": null,
      "text": "Verify their account email.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00039",
      "path": "tabs.t.0.body.content[39]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3335,
      "endIndex": 3414,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.8vdujc3prvqi",
      "nestingLevel": null,
      "table": null,
      "text": "Complete ID verification to confirm their identity and that they are an adult.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00040",
      "path": "tabs.t.0.body.content[40]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3414,
      "endIndex": 3588,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.8vdujc3prvqi",
      "nestingLevel": null,
      "table": null,
      "text": "Declare that they are the athlete’s parent or authorized legal Guardian. The Guardian relationship is self-declared and is not independently verified under the current plan.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00041",
      "path": "tabs.t.0.body.content[41]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3588,
      "endIndex": 3690,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.8vdujc3prvqi",
      "nestingLevel": null,
      "table": null,
      "text": "Accept the applicable Terms of Use, acknowledge the Privacy Notice, and provide any required consent.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00042",
      "path": "tabs.t.0.body.content[42]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3690,
      "endIndex": 3851,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Each action is recorded with its wording/version, actor and timestamp, including any later withdrawal. The MVP supports one active Guardian per Athlete Profile.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00043",
      "path": "tabs.t.0.body.content[43]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3851,
      "endIndex": 3868,
      "namedStyleType": "HEADING_1",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Scout safeguards",
      "protectedControls": []
    },
    {
      "paragraphId": "P00044",
      "path": "tabs.t.0.body.content[44]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3868,
      "endIndex": 3929,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Before a Scout can access athlete Sport Profiles, they must:",
      "protectedControls": []
    },
    {
      "paragraphId": "P00045",
      "path": "tabs.t.0.body.content[45]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3929,
      "endIndex": 3957,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.8eb498v8i5q2",
      "nestingLevel": null,
      "table": null,
      "text": "Verify their account email.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00046",
      "path": "tabs.t.0.body.content[46]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3957,
      "endIndex": 4036,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.8eb498v8i5q2",
      "nestingLevel": null,
      "table": null,
      "text": "Complete ID verification to confirm their identity and that they are an adult.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00047",
      "path": "tabs.t.0.body.content[47]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 4036,
      "endIndex": 4225,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.8eb498v8i5q2",
      "nestingLevel": null,
      "table": null,
      "text": "Provide affiliation details: organization name, type, country/branch, official website, professional title, relationship type, recruiting scope and organization work email where available.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00048",
      "path": "tabs.t.0.body.content[48]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 4225,
      "endIndex": 4406,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.8eb498v8i5q2",
      "nestingLevel": null,
      "table": null,
      "text": "Provide an official corroboration route: an organization staff page, federation/league directory, or confirmation through an independently verified organization-controlled channel.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00049",
      "path": "tabs.t.0.body.content[49]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 4406,
      "endIndex": 4567,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.8eb498v8i5q2",
      "nestingLevel": null,
      "table": null,
      "text": "Pass manual review. An authorized administrator must confirm the organization’s eligibility and the Scout’s current relationship, role and recruiting authority.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00050",
      "path": "tabs.t.0.body.content[50]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 4567,
      "endIndex": 4697,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Until every gate passes, the Scout cannot search for, open, message, save, evaluate or request information from athlete profiles.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00051",
      "path": "tabs.t.0.body.content[51]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 4697,
      "endIndex": 4888,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Confirmed affiliations are currently valid for 12 months and may be suspended or revoked. If any access requirement is lost, athlete access is removed immediately and the change is recorded.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00052",
      "path": "tabs.t.0.body.content[52]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 4888,
      "endIndex": 4889,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "",
      "protectedControls": []
    },
    {
      "paragraphId": "P00053",
      "path": "tabs.t.0.body.content[53]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 4889,
      "endIndex": 4944,
      "namedStyleType": "HEADING_1",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Athlete information intended for Scout-facing profiles",
      "protectedControls": []
    },
    {
      "paragraphId": "P00054",
      "path": "tabs.t.0.body.content[54]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 4944,
      "endIndex": 5039,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "When a Sport Profile is visible, eligible Scouts may see the following recruiting information:",
      "protectedControls": []
    },
    {
      "paragraphId": "P00055",
      "path": "tabs.t.0.body.content[55]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 5039,
      "endIndex": 5115,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.oqbv9yfcyjxp",
      "nestingLevel": null,
      "table": null,
      "text": "Basic profile: name, city, country of residence, citizenship and languages.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00056",
      "path": "tabs.t.0.body.content[56]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 5115,
      "endIndex": 5294,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.oqbv9yfcyjxp",
      "nestingLevel": null,
      "table": null,
      "text": "Education and timeline: education level, school country, expected or completed graduation date, target college start term/year, recruiting availability and destination interests.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00057",
      "path": "tabs.t.0.body.content[57]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 5294,
      "endIndex": 5424,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.oqbv9yfcyjxp",
      "nestingLevel": null,
      "table": null,
      "text": "Soccer profile: height, weight, positions, preferred foot, current team and season, playing history, statistics and achievements.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00058",
      "path": "tabs.t.0.body.content[58]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 5424,
      "endIndex": 5564,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.oqbv9yfcyjxp",
      "nestingLevel": null,
      "table": null,
      "text": "Approved media: profile photo, Main Evaluation Video, Skill Clips and Extended Match Footage that are ready and permitted for Scout access.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00059",
      "path": "tabs.t.0.body.content[59]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 5564,
      "endIndex": 5565,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
