      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 5565,
      "endIndex": 5729,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "The following information remains private even when the Sport Profile is visible. A Scout may receive it only through a separate request and approved access grant:",
      "protectedControls": []
    },
    {
      "paragraphId": "P00061",
      "path": "tabs.t.0.body.content[61]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 5729,
      "endIndex": 5841,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.bwuyv08bwem6",
      "nestingLevel": null,
      "table": null,
      "text": "Coach-reference contact details. Only the existence/status of a coach reference appears on the visible profile.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00062",
      "path": "tabs.t.0.body.content[62]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 5841,
      "endIndex": 6147,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.bwuyv08bwem6",
      "nestingLevel": null,
      "table": null,
      "text": "Athlete documents: Academic Records (Transcript, Grade Report / Report Card, School Report); Graduation or Examination Credentials (Diploma / Proof of Graduation, Leaving Certificate, National Examination Results); and Test Score Reports (SAT, ACT, TOEFL, IELTS, Duolingo English Test, Cambridge English).",
      "protectedControls": []
    },
