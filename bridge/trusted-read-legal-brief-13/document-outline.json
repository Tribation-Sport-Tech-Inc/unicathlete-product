      "path": "tabs.t.0.body.content[66]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 6292,
      "endIndex": 6414,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.4b00ngvlrkk2",
      "nestingLevel": null,
      "table": null,
      "text": "Privacy Notice, including identity-verification provider involvement, cross-border processing, retention and user rights.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00067",
      "path": "tabs.t.0.body.content[67]",
