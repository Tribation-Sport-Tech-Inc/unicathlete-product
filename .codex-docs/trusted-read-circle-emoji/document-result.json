            {
              "startIndex": 1,
              "endIndex": 36,
              "paragraph": {
                "elements": [
                  {
                    "startIndex": 1,
                    "endIndex": 36,
                    "textRun": {
                      "content": "UnicAthlete MVP Development Slices\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "headingId": "h.j1b4u48lhy11",
                  "namedStyleType": "TITLE",
                  "direction": "LEFT_TO_RIGHT"
                }
              }
            },
            {
              "startIndex": 36,
              "endIndex": 156,
              "paragraph": {
                "elements": [
                  {
                    "startIndex": 36,
                    "endIndex": 156,
                    "textRun": {
                      "content": "These slices are internal development milestones. They will be combined and tested before the MVP is released to users.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "namedStyleType": "NORMAL_TEXT",
                  "direction": "LEFT_TO_RIGHT"
                }
              }
            },
            {
              "startIndex": 156,
              "endIndex": 208,
              "paragraph": {
                "elements": [
                  {
                    "startIndex": 156,
                    "endIndex": 208,
                    "textRun": {
                      "content": "Status key: ✅ Done · 🚧 In progress · ⏳ Not started\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "namedStyleType": "NORMAL_TEXT",
                  "direction": "LEFT_TO_RIGHT"
                }
              }
            },
            {
              "startIndex": 208,
              "endIndex": 258,
              "paragraph": {
                "elements": [
                  {
                    "startIndex": 208,
                    "endIndex": 258,
                    "textRun": {
                      "content": "🚧 Slice 1 — Account and Relationship Foundation \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "headingId": "h.9ux8qukhi3mq",
                  "namedStyleType": "HEADING_2",
                  "direction": "LEFT_TO_RIGHT"
                }
              }
            },
            {
              "startIndex": 258,
              "endIndex": 374,
              "paragraph": {
                "elements": [
                  {
                    "startIndex": 258,
                    "endIndex": 374,
                    "textRun": {
                      "content": "Build account creation, age-based athlete and guardian relationships, legal records, and restricted Scout accounts.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "namedStyleType": "NORMAL_TEXT",
                  "direction": "LEFT_TO_RIGHT"
                }
              }
            },
            {
              "startIndex": 374,
              "endIndex": 428,
              "paragraph": {
                "elements": [
                  {
                    "startIndex": 374,
                    "endIndex": 428,
                    "textRun": {
                      "content": "⏳ Slice 2 — Athlete Onboarding and Profile Foundation\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "headingId": "h.q0dy3ojxrd5l",
                  "namedStyleType": "HEADING_2",
                  "direction": "LEFT_TO_RIGHT"
                }
              }
            },
            {
              "startIndex": 428,
              "endIndex": 581,
              "paragraph": {
                "elements": [
                  {
                    "startIndex": 428,
                    "endIndex": 581,
                    "textRun": {
                      "content": "Build athlete onboarding, the shared Athlete Profile, the Soccer Profile, profile completion, Recruiter-Ready status, and athlete–guardian access rules.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "namedStyleType": "NORMAL_TEXT",
                  "direction": "LEFT_TO_RIGHT"
                }
              }
            },
            {
              "startIndex": 581,
              "endIndex": 639,
              "paragraph": {
                "elements": [
                  {
                    "startIndex": 581,
                    "endIndex": 639,
                    "textRun": {
                      "content": "⏳ Slice 3 — Scout Onboarding and Affiliation Verification\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "headingId": "h.gxgl9vd7xpe2",
                  "namedStyleType": "HEADING_2",
                  "direction": "LEFT_TO_RIGHT"
                }
              }
            },
            {
              "startIndex": 639,
              "endIndex": 755,
              "paragraph": {
                "elements": [
                  {
                    "startIndex": 639,
                    "endIndex": 755,
                    "textRun": {
                      "content": "Build Scout onboarding, the Scout Profile, organization affiliation applications, and the manual admin review flow.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "namedStyleType": "NORMAL_TEXT",
                  "direction": "LEFT_TO_RIGHT"
                }
              }
            },
            {
              "startIndex": 755,
              "endIndex": 811,
              "paragraph": {
                "elements": [
                  {
                    "startIndex": 755,
                    "endIndex": 811,
                    "textRun": {
                      "content": "⏳ Slice 4 — Identity Verification and Eligibility Gates\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "headingId": "h.lru8im8q22w",
                  "namedStyleType": "HEADING_2",
                  "direction": "LEFT_TO_RIGHT"
                }
              }
            },
            {
              "startIndex": 811,
              "endIndex": 953,
              "paragraph": {
                "elements": [
                  {
                    "startIndex": 811,
                    "endIndex": 953,
                    "textRun": {
                      "content": "Integrate the ID-verification provider and keep affiliation review or athlete visibility blocked until the required verification is complete.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "namedStyleType": "NORMAL_TEXT",
                  "direction": "LEFT_TO_RIGHT"
                }
              }
            },
            {
              "startIndex": 953,
              "endIndex": 994,
              "paragraph": {
                "elements": [
                  {
                    "startIndex": 953,
                    "endIndex": 994,
                    "textRun": {
                      "content": "⏳ Slice 5 — Product Analytics Foundation\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "headingId": "h.w88xplq64jdf",
                  "namedStyleType": "HEADING_2",
                  "direction": "LEFT_TO_RIGHT"
                }
              }
            },
            {
              "startIndex": 994,
              "endIndex": 1196,
              "paragraph": {
                "elements": [
                  {
                    "startIndex": 994,
                    "endIndex": 1196,
                    "textRun": {
                      "content": "Define and collect the events needed to understand signup, onboarding, profile completion, paid-feature demand, and user activity. Planning starts earlier, and implementation may run alongside Slice 4.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "namedStyleType": "NORMAL_TEXT",
                  "direction": "LEFT_TO_RIGHT"
                }
              }
            },
            {
              "startIndex": 1196,
              "endIndex": 1248,
              "paragraph": {
                "elements": [
                  {
                    "startIndex": 1196,
                    "endIndex": 1248,
                    "textRun": {
                      "content": "⏳ Slice 6 — Media, Documents and Paid Upload Limits\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "headingId": "h.ixwvc2wh04zn",
                  "namedStyleType": "HEADING_2",
                  "direction": "LEFT_TO_RIGHT"
                }
              }
            },
            {
              "startIndex": 1248,
              "endIndex": 1375,
              "paragraph": {
                "elements": [
                  {
                    "startIndex": 1248,
                    "endIndex": 1375,
                    "textRun": {
                      "content": "Add media and document uploads, video processing, free limits, paid extra capacity, privacy controls, and sharing permissions.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "namedStyleType": "NORMAL_TEXT",
                  "direction": "LEFT_TO_RIGHT"
                }
              }
            },
            {
              "startIndex": 1375,
              "endIndex": 1429,
              "paragraph": {
                "elements": [
                  {
                    "startIndex": 1375,
                    "endIndex": 1429,
                    "textRun": {
                      "content": "⏳ Slice 7 — Visibility, Discovery and Profile Sharing\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "headingId": "h.y6hfm5tfpln3",
                  "namedStyleType": "HEADING_2",
                  "direction": "LEFT_TO_RIGHT"
                }
              }
            },
            {
              "startIndex": 1429,
              "endIndex": 1557,
              "paragraph": {
                "elements": [
                  {
                    "startIndex": 1429,
                    "endIndex": 1557,
                    "textRun": {
                      "content": "Add athlete-profile visibility controls, Scout search and discovery, internal sharing, and controlled external profile sharing.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "namedStyleType": "NORMAL_TEXT",
                  "direction": "LEFT_TO_RIGHT"
                }
              }
            },
            {
              "startIndex": 1557,
              "endIndex": 1606,
              "paragraph": {
                "elements": [
                  {
                    "startIndex": 1557,
                    "endIndex": 1606,
                    "textRun": {
                      "content": "⏳ Slice 8 — Scout Workspace and Recruiting Tools\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "headingId": "h.ydixbf6utm8s",
                  "namedStyleType": "HEADING_2",
                  "direction": "LEFT_TO_RIGHT"
                }
              }
            },
            {
              "startIndex": 1606,
              "endIndex": 1706,
              "paragraph": {
                "elements": [
                  {
                    "startIndex": 1606,
                    "endIndex": 1706,
                    "textRun": {
                      "content": "Build recruiting projects, saved athletes, evaluations, notes, and basic recruiting pipeline tools.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "namedStyleType": "NORMAL_TEXT",
                  "direction": "LEFT_TO_RIGHT"
                }
              }
            },
            {
              "startIndex": 1706,
              "endIndex": 1760,
              "paragraph": {
                "elements": [
                  {
                    "startIndex": 1706,
                    "endIndex": 1760,
                    "textRun": {
                      "content": "⏳ Slice 9 — Messaging, Requests and Guardian Controls\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "headingId": "h.kh09o2kkjlj3",
                  "namedStyleType": "HEADING_2",
                  "direction": "LEFT_TO_RIGHT"
                }
              }
            },
            {
              "startIndex": 1760,
              "endIndex": 1871,
              "paragraph": {
                "elements": [
                  {
                    "startIndex": 1760,
                    "endIndex": 1871,
                    "textRun": {
                      "content": "Add athlete–Scout messaging, information and document requests, and the required guardian controls for minors.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "namedStyleType": "NORMAL_TEXT",
                  "direction": "LEFT_TO_RIGHT"
                }
              }
            },
            {
              "startIndex": 1871,
              "endIndex": 1913,
              "paragraph": {
                "elements": [
                  {
                    "startIndex": 1871,
                    "endIndex": 1913,
                    "textRun": {
                      "content": "⏳ Slice 10 — Platform Notification Center\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "headingId": "h.b3jhl55aw5wc",
                  "namedStyleType": "HEADING_2",
                  "direction": "LEFT_TO_RIGHT"
                }
              }
            },
            {
              "startIndex": 1913,
              "endIndex": 2035,
              "paragraph": {
                "elements": [
                  {
                    "startIndex": 1913,
                    "endIndex": 2035,
                    "textRun": {
                      "content": "Add in-platform notifications, unread counts, action links, and basic preferences using events created by earlier slices.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "namedStyleType": "NORMAL_TEXT",
                  "direction": "LEFT_TO_RIGHT"
                }
              }
            },
            {
              "startIndex": 2035,
              "endIndex": 2079,
              "paragraph": {
                "elements": [
                  {
                    "startIndex": 2035,
                    "endIndex": 2079,
                    "textRun": {
                      "content": "⏳ Slice 11 — Dashboards and MVP Integration\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "headingId": "h.5umutu4ic3je",
                  "namedStyleType": "HEADING_2",
                  "direction": "LEFT_TO_RIGHT"
                }
              }
            },
            {
              "startIndex": 2079,
              "endIndex": 2210,
              "paragraph": {
                "elements": [
                  {
                    "startIndex": 2079,
                    "endIndex": 2210,
                    "textRun": {
                      "content": "Build athlete, guardian, and Scout dashboards, connect navigation and status summaries, and test the complete MVP from end to end.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "namedStyleType": "NORMAL_TEXT",
                  "direction": "LEFT_TO_RIGHT"
                }
              }
            },
            {
              "startIndex": 2210,
              "endIndex": 2211,
              "paragraph": {
                "elements": [
                  {
                    "startIndex": 2210,
                    "endIndex": 2211,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "namedStyleType": "NORMAL_TEXT",
                  "direction": "LEFT_TO_RIGHT"
                }
              }
            }
          ]
